server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;

    # "/" serves the page this service is for; the other page stays
    # reachable by name so one link can point at either.
    index ${ROOT_DOC};

    # Redirects behind Railway's proxy must be relative: nginx only knows its
    # internal port, and "http://host:8080/..." is not a public address.
    absolute_redirect off;

    location / {
        try_files $uri $uri/ =404;
    }

    location = /resume { return 302 /resume.html; }
    location = /portfolio { return 302 /portfolio.html; }
    location = /case-studies { return 302 /case-studies.html; }

    gzip on;
    gzip_types text/html text/css application/pdf;
    add_header X-Content-Type-Options nosniff;
}
